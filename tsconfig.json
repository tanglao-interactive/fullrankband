{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "esModuleInterop": true, "skipLibCheck": true, "noEmit": true, "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true
  },
  "include": ["amplify/**/*.ts", "src/**/*.ts", "vite.config.ts"]
}
